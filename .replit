modules = ["nodejs-24", "python-3.11"]

[deployment]
deploymentTarget = "cloudrun"
run = ["python", "voogle/app.py"]

[deployment.postBuild]
args = ["pip", "install", "-r", "voogle/requirements.txt"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Voogle Flask App"

[[workflows.workflow]]
name = "Voogle Flask App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd voogle && python app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[userenv]

[userenv.shared]
AT_USERNAME = "sandbox"
AT_SENDER_ID = "15296"
